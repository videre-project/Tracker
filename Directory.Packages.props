<Project>

  <PropertyGroup>
    <!-- Enable central package management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Enable deterministic NuGet package restore -->
    <RestoreLockedMode>true</RestoreLockedMode>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
  </PropertyGroup>

  <PropertyGroup Label="SDKVersions">
    <MTGOSDKVersion>1.6.6.20260726</MTGOSDKVersion>
  </PropertyGroup>

  <ItemGroup Label="PackageVersions">
    <!-- ASP.NET Web API -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi"
                    Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.SpaProxy"
                    Version="10.0.10" />
    <PackageVersion Include="Scalar.AspNetCore"
                    Version="2.12.46" />
    <!-- Swagger -->
    <PackageVersion Include="Swashbuckle.AspNetCore"
                    Version="10.2.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Annotations"
                    Version="10.2.3" />
    <!-- SQLite Database -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore"
                    Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite"
                    Version="10.0.10" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3"
                    Version="2.1.12" />
    <!-- WebView2 Application -->
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded"
                    Version="10.0.10" />
    <PackageVersion Include="Microsoft.Web.WebView2"
                    Version="1.0.3800.47" />
    <!-- MTGOSDK -->
    <PackageVersion Include="MTGOSDK"
                    Version="$(MTGOSDKVersion)" />
    <PackageVersion Include="MTGOSDK.MSBuild"
                    Version="$(MTGOSDKVersion)" />
    <PackageVersion Include="MTGOSDK.Win32"
                    Version="$(MTGOSDKVersion)" />
    <!-- Tracker.Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost"
                    Version="10.0.10" />
    <PackageVersion Include="NUnit"
                    Version="4.4.0" />
    <PackageVersion Include="NUnit.Analyzers"
                    Version="4.10.0" />
    <PackageVersion Include="NUnit3TestAdapter"
                    Version="5.2.0" />
  </ItemGroup>

</Project>
