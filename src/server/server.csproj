<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>Videre Tracker</AssemblyName>
    <RootNamespace>MTGOTracker</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <VidereGeneratedDirectory>$(MSBuildProjectDirectory)\obj\Videre</VidereGeneratedDirectory>
    <VidereOpenApiSpecPath>$(VidereGeneratedDirectory)\openapi.json</VidereOpenApiSpecPath>
    <VidereGeneratedClientPath>$(VidereGeneratedDirectory)\VidereOpenAPIClient.g.cs</VidereGeneratedClientPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(VidereGeneratedClientPath)" Visible="false" />
  </ItemGroup>

  <Target Name="GenerateVidereOpenApiClient"
          BeforeTargets="CoreCompile"
          Condition="'$(SkipOpenApiGeneration)' != 'true' And '$(TRACKER_SKIP_OPENAPI_GEN)' != 'true'">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(SolutionDir)" />
    <MakeDir Directories="$(VidereGeneratedDirectory)" />
    <Exec Command="node src/server/scripts/prepareVidereOpenAPI.cjs &quot;$(VidereOpenApiSpecPath)&quot;"
          WorkingDirectory="$(SolutionDir)" />
    <PropertyGroup>
      <NswagCommand>/opt/wine/bin/wine /home/wine/tracker-tools/nswag.exe openapi2csclient /Input:&quot;$(VidereOpenApiSpecPath)&quot; /Output:&quot;$(VidereGeneratedClientPath)&quot; /ClassName:VidereOpenAPIClient /Namespace:MTGOTracker.Services.Videre.Generated /OperationGenerationMode:SingleClientFromOperationId /InjectHttpClient:true /DisposeHttpClient:false /UseBaseUrl:false /GenerateClientInterfaces:false /GenerateExceptionClasses:true /ExceptionClass:VidereOpenAPIException /GenerateOptionalParameters:true /JsonLibrary:SystemTextJson /JsonLibraryVersion:10.0 /GenerateNullableReferenceTypes:true /GenerateOptionalPropertiesAsNullable:true /TypeAccessModifier:internal /ClientClassAccessModifier:internal /GenerateJsonMethods:false /GenerateDataAnnotations:false /NewLineBehavior:LF</NswagCommand>
    </PropertyGroup>
    <Exec Command="$(NswagCommand)"
          WorkingDirectory="$(ProjectDir)"
          EnvironmentVariables="DOTNET_ROOT=Z:\home\wine\windows-dotnet"
          Condition="'$(TRACKER_DEV_CONTAINER)' == 'true'" />
    <Exec Command="dotnet nswag openapi2csclient /Input:&quot;$(VidereOpenApiSpecPath)&quot; /Output:&quot;$(VidereGeneratedClientPath)&quot; /ClassName:VidereOpenAPIClient /Namespace:MTGOTracker.Services.Videre.Generated /OperationGenerationMode:SingleClientFromOperationId /InjectHttpClient:true /DisposeHttpClient:false /UseBaseUrl:false /GenerateClientInterfaces:false /GenerateExceptionClasses:true /ExceptionClass:VidereOpenAPIException /GenerateOptionalParameters:true /JsonLibrary:SystemTextJson /JsonLibraryVersion:10.0 /GenerateNullableReferenceTypes:true /GenerateOptionalPropertiesAsNullable:true /TypeAccessModifier:internal /ClientClassAccessModifier:internal /GenerateJsonMethods:false /GenerateDataAnnotations:false /NewLineBehavior:LF"
          WorkingDirectory="$(ProjectDir)"
          Condition="'$(TRACKER_DEV_CONTAINER)' != 'true'" />
  </Target>

  <!-- Runtime Properties -->
  <Target Name="GenerateProductInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <ProductInfoGeneratedPath>$(IntermediateOutputPath)ProductInfo.g.cs</ProductInfoGeneratedPath>
    </PropertyGroup>
    <!-- Read version from package.json. Container publishes without Node pass
         PackageVersion and SkipNodeBuildSteps instead. -->
    <Exec Command="node $(MSBuildProjectDirectory)/scripts/get-version.js" ConsoleToMSBuild="true"
          Condition="'$(SkipNodeBuildSteps)' != 'true'">
      <Output TaskParameter="ConsoleOutput" PropertyName="PackageVersion" />
    </Exec>
    <Error Text="PackageVersion must be passed when SkipNodeBuildSteps is set."
           Condition="'$(SkipNodeBuildSteps)' == 'true' And '$(PackageVersion)' == ''" />
    <WriteLinesToFile
      File="$(ProductInfoGeneratedPath)"
      Lines='namespace MTGOTracker%3B public static class ProductInfo { public const string Name = "$(AssemblyName)"%3B public const string Version = "$(PackageVersion)"%3B }'
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(ProductInfoGeneratedPath)" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Generate the sharing policy from framework references rather than broad
       namespace prefixes (System.Reactive, for example, is a private package). -->
  <Target Name="GeneratePluginFrameworkAssemblies" BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_PluginFrameworkAssembly Include="@(ReferencePath)"
          Condition="'%(ReferencePath.FrameworkReferenceName)' != ''" />
    </ItemGroup>
    <PropertyGroup>
      <_PluginFrameworkNames>@(_PluginFrameworkAssembly->'&quot;%(Filename)&quot;', ',')</_PluginFrameworkNames>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)PluginFrameworkAssemblies.g.cs"
        Lines="namespace MTGOTracker.Services%3B public static partial class PluginService { private static readonly System.Collections.Generic.HashSet&lt;string&gt; SharedFrameworkAssemblies = new(System.StringComparer.OrdinalIgnoreCase) { $(_PluginFrameworkNames) }%3B }"
        Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PluginFrameworkAssemblies.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Frontend SPA Configuration -->
  <PropertyGroup>
    <SpaRoot>$(MSBuildProjectDirectory)\..\client</SpaRoot>
    <SpaProxyLaunchCommand>pnpm run dev</SpaProxyLaunchCommand>
    <!-- Workaround for https://github.com/dotnet/aspnetcore/issues/45700 -->
    <SpaProxyLaunchCommand Condition="$([MSBuild]::IsOsPlatform('Windows'))">cmd.exe /s /c $(SpaProxyLaunchCommand)</SpaProxyLaunchCommand>
    <SpaProxyLaunchCommand Condition="$([MSBuild]::IsOSUnixLike())">sh -c %5C&quot;$(SpaProxyLaunchCommand)%5C&quot;</SpaProxyLaunchCommand>
    <!-- Disable launch command in dev container (external Vite dev server) -->
    <SpaProxyLaunchCommand Condition="'$(TRACKER_DEV_CONTAINER)' == 'true'"></SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:5279</SpaProxyServerUrl>
    <!-- Vite runs in the development container unless its URL is overridden. -->
    <SpaProxyServerUrl Condition="'$(TRACKER_DEV_CONTAINER)' == 'true'">http://127.0.0.1:5279</SpaProxyServerUrl>
    <SpaProxyServerUrl Condition="'$(TRACKER_DEV_CONTAINER)' == 'true' And '$(TRACKER_UI_URL)' != ''">$(TRACKER_UI_URL)</SpaProxyServerUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embed the build output of the client project -->
    <EmbeddedResource Include="$(SpaRoot)\dist\**\*"
                      LogicalName="%(RecursiveDir)%(FileName)%(Extension)" />
    <!-- Embed installer EULA markdown from solution root -->
    <EmbeddedResource Include="$(SolutionDir)EULA.md"
                      LogicalName="MTGOTracker.EULA.md" />
  </ItemGroup>

  <!-- Prevent dotnet watch from trying to evaluate or watch the client project -->
  <PropertyGroup>
    <DotNetWatchExclude>$(SpaRoot)\**\*</DotNetWatchExclude>
  </PropertyGroup>
  <ItemGroup Condition="'$(DOTNET_WATCH)' == '1'">
    <Watch Include="$(SpaRoot)\**\*" Watch="false" />
  </ItemGroup>

  <!-- Manually generate spa-proxy-config.json for the SpaProxy middleware -->
  <Target Name="GenerateSpaProxyConfig" BeforeTargets="Build">
    <PropertyGroup>
      <SpaProxyConfigPath>$(OutputPath)spa-proxy-config.json</SpaProxyConfigPath>
      <SpaProxyConfigContent Condition="'$(TRACKER_DEV_CONTAINER)' != 'true'">{
  "LaunchCommand": "$(SpaProxyLaunchCommand.Replace('\', '\\'))",
  "WorkingDirectory": "$(SpaRoot.Replace('\', '\\'))",
  "MaxRetries": 15,
  "ServerUrl": "$(SpaProxyServerUrl)"
}</SpaProxyConfigContent>
      <SpaProxyConfigContent Condition="'$(TRACKER_DEV_CONTAINER)' == 'true'">{
  "ServerUrl": "$(SpaProxyServerUrl)"
}</SpaProxyConfigContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(SpaProxyConfigPath)" Lines="$(SpaProxyConfigContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(SpaProxyConfigPath)" />
    </ItemGroup>
  </Target>

  <!-- Ensure local builds do not keep stale portable-mode installer bypass flags -->
  <Target Name="ClearInstallerDisableEnvironment" BeforeTargets="Build;Publish">
    <Exec Command="node $(MSBuildProjectDirectory)/scripts/clear-installer-env.js" ContinueOnError="true" />
  </Target>

  <!--
    Prevent package pruning of Microsoft.Extensions.FileProviders.Embedded
    https://github.com/dotnet/aspnetcore/issues/63719
  -->
  <Target Name="_PreserveFileProvidersEmbeddedPackageReference"
          AfterTargets="AddPrunePackageReferences">
    <ItemGroup>
      <PrunePackageReference Remove="Microsoft.Extensions.FileProviders.Embedded" />
    </ItemGroup>
  </Target>

  <!-- Generate Typescript types from the Web API's OpenAPI spec on build -->
  <Target Name="GenerateOpenApiSpec"
          AfterTargets="Build"
          Condition="'$(SkipOpenApiGeneration)' != 'true' And '$(TRACKER_SKIP_OPENAPI_GEN)' != 'true'">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(ProjectDir)" />
    <Exec Command="/opt/wine/bin/wine /home/wine/tracker-tools/swagger.exe tofile --output &quot;$(OutputPath)openapi.json&quot; &quot;$(OutputPath)$(AssemblyName).dll&quot; v1"
          WorkingDirectory="$(ProjectDir)"
          EnvironmentVariables="TRACKER_DISABLE_INSTALLER=1;DOTNET_ROOT=Z:\home\wine\windows-dotnet;WINEPATH=Z:\home\wine\windows-dotnet"
          Condition="'$(TRACKER_DEV_CONTAINER)' == 'true'" />
    <Exec Command="dotnet swagger tofile --output &quot;$(OutputPath)openapi.json&quot; &quot;$(OutputPath)$(AssemblyName).dll&quot; v1"
          WorkingDirectory="$(ProjectDir)"
          EnvironmentVariables="TRACKER_DISABLE_INSTALLER=1"
          Condition="'$(TRACKER_DEV_CONTAINER)' != 'true'" />

    <PropertyGroup>
      <OpenApiSpecPath>src/server/$(OutputPath)openapi.json</OpenApiSpecPath>
      <OpenApiSpecPath>$(OpenApiSpecPath.Replace('\', '/'))</OpenApiSpecPath>
    </PropertyGroup>

    <Exec Command="pnpm openapi-typescript $(OpenApiSpecPath) --output src/client/src/types/api.d.ts --path-params-as-types --root-types --root-types-no-schema-prefix"
          WorkingDirectory="$(SolutionDir)" />
    <Exec Command="node src/client/scripts/stripNamespaceFromTypes.cjs src/client/src/types/api.d.ts src/client/src/types/api.d.ts"
          WorkingDirectory="$(SolutionDir)" />
  </Target>

  <!-- Enable XML documentation file generation for Swagger -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);CS1570;CS1573;CS1574;CS1587;CS1591</NoWarn>
  </PropertyGroup>

  <!-- Set Application Icon -->
  <PropertyGroup>
    <ApplicationIcon>$(SpaRoot)\public\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publishing Configuration -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <!-- Desktop plugins can use assemblies that Tracker itself does not reference. -->
    <RemoveUnusedDesktopRuntimeFiles>false</RemoveUnusedDesktopRuntimeFiles>
    <DebugType>embedded</DebugType>
    <StaticWebAssetsEnabled Condition="'$(Configuration)' == 'Debug'">true</StaticWebAssetsEnabled>
    <StaticWebAssetsEnabled Condition="'$(Configuration)' != 'Debug'">false</StaticWebAssetsEnabled>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="appsettings.json" />
    <Content Remove="appsettings.*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Web API -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy"
                      PrivateAssets="All" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" />
    <!-- SQLite Database -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <!-- WebView2 Application -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <!-- Tracker plugin API -->
    <ProjectReference Include="..\plugins\plugins.csproj" />
    <!-- MTGOSDK -->
    <PackageReference Include="MTGOSDK" />
    <PackageReference Include="MTGOSDK.Win32" />
  </ItemGroup>

</Project>
